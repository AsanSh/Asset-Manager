# Скопируйте в deploy/server/.env и заполните перед ./deploy/server/install.sh
# cp deploy/server/env.template deploy/server/.env

# PostgreSQL (можно оставить текущий Neon — данные и пользователи сохранятся)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# API слушает локально; снаружи — через nginx
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Публичный URL сайта (без слэша на конце). Пример: https://app.example.kg или http://203.0.113.10
PUBLIC_URL=http://localhost

# CORS — тот же URL, что PUBLIC_URL (можно несколько через запятую)
ALLOWED_ORIGINS=http://localhost

# Опционально: Bearer для /cron/* (если настроите cron на сервере)
CRON_SECRET=

# Опционально: Resend, Sentry, Blob — если используете в prod
# RESEND_API_KEY=
# SENTRY_DSN=
# BLOB_READ_WRITE_TOKEN=
